# Local due dates and the recycle bin work without any of these services.
# Keep both opt-ins false until the owner approves hosted setup and deployment.
VITE_REMINDERS_ENABLED=false
REMINDERS_ENABLED=false

# Use the exact HTTPS origin for the approved preview/production deployment.
REMINDERS_ORIGIN=https://dreamie-todos.vercel.app

# Generate a stable pair with the official web-push package. Never use VITE_ here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR_CONTACT_EMAIL

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# A separate strong random server secret for Vercel's daily maintenance request.
CRON_SECRET=
